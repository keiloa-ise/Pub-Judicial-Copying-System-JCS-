{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Jcs": "Server=localhost;Database=Jcs;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "jcs",
    "Audience": "jcs",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "FormDraftCleanup": {
    "Enabled": true,
    "OlderThanDays": 30,
    "Cron": "0 3 * * *",
    "TimeZoneId": "UTC"
  }
}
